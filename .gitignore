# P4 frontend
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/.e2e/

# Release hardening: local databases, secrets and runtime state must never be committed
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.env.*
*.key
*.pem
*.p12
kb_storage/
.pytest_cache/
